{
  "name": "dev-launcher",
  "version": "0.1.0",
  "description": "本地开发服务启动器 MVP",
  "license": "MIT",
  "author": "hong1017song-afk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hong1017song-afk/dev-launcher.git"
  },
  "bugs": {
    "url": "https://github.com/hong1017song-afk/dev-launcher/issues"
  },
  "homepage": "https://github.com/hong1017song-afk/dev-launcher#readme",
  "main": "dist/main/index.js",
  "productName": "Dev Launcher",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json && electron dist/main/index.js",
    "dev:renderer": "vite",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.main.json",
    "build:all": "npm run build:main",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "electron dist/main/index.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.0.0",
    "fastify": "^4.28.0",
    "find-process": "^1.4.7",
    "open": "^10.1.0",
    "openai": "^4.52.0",
    "tree-kill": "^1.2.2",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.3.0",
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "antd": "^5.18.0",
    "concurrently": "^8.2.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vite-plugin-electron-renderer": "^0.14.0"
  }
}
